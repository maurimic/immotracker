# Immotracker – Umgebungsvariablen
# Kopiere diese Datei nach .env und passe die Werte an

# Port für die Web-App
PORT=3000

# Anthropic API Key für KI-Fallback (Claude Haiku)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Sheets Integration
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEET_NAME=Kontoumsätze

# NextAuth (für zukünftige Auth-Erweiterung)
NEXTAUTH_SECRET=change-me-to-a-random-secret-32chars
NEXTAUTH_URL=http://localhost:3000

# Backup Cron (Standard: täglich 2 Uhr)
BACKUP_CRON=0 2 * * *
