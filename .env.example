# Immotracker – Umgebungsvariablen
# Kopiere diese Datei nach .env und passe die Werte an

# Port für die Web-App
PORT=3000

# Anthropic API Key für KI-Fallback (Claude Haiku)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Sheets Integration
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_SPREADSHEET_ID=1GslK8LFx_Day6hjEcQnEY_nmX06KuJwRRdqVr1ph8HU
GOOGLE_SHEET_NAME=Kontobewegung
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/google-service-account.json

# Passwortschutz für das Login-Fenster
APP_PASSWORD=dein-geheimes-passwort

# NextAuth / Session Secret
NEXTAUTH_SECRET=change-me-to-a-random-secret-32chars
NEXTAUTH_URL=http://localhost:3000

# Backup Cron (Standard: täglich 2 Uhr)
BACKUP_CRON=0 2 * * *
